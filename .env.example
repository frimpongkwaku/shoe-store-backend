PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shoe-store
JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP account used to send verification and password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Edward Shoe Store <no-reply@example.com>

# Frontend root URL; the verification page is appended automatically
FRONTEND_URL=http://localhost:5500

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500